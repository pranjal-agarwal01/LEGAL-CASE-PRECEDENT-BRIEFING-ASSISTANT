    "key_facts": [
      {
        "text": "Mr Rowe agreed to hire the rooftop terrace for 5 July 2025 for \u00a312,000 and paid \u00a34,000 deposit.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "Skyline advertised the terrace as offering 'the best view in London of the Thames Victory Fireworks', promising 'front-row seats for the display'.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "The written hire agreement only described 'exclusive use of the terrace, 6pm to midnight, with bar service' and made no mention of the fireworks.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "The planned fireworks display was cancelled by the council due to a safety review on 28 June 2025.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "Despite the cancellation, the terrace, bar, and staff remained available on 5 July 2025.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Mr Rowe cancelled his event on 29 June and requested the return of his deposit.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Skyline refused to return the deposit and claimed the remaining balance, arguing the terrace was still usable and the fireworks were Mr Rowe's own commercial purpose.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Mr Rowe contends the contract was frustrated due to the fireworks cancellation and seeks refund and release from further payment.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Mr Rowe argues that the hire contract was frustrated by the cancellation of the fireworks. He wants his deposit back and to avoid paying the balance.",
      "citations": [
        "F7"
      ]
    }
  },
