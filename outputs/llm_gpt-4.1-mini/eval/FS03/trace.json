    "key_facts": [
      {
        "text": "PeakFit published an advertisement on 5 January 2025 promising \u00a32,000 to anyone completing 100 workouts and losing 5 kg by 15 April, backing it with \u00a3100,000 in Barclays.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "The advertisement required participants to log all workouts and weigh in using the app's connected scales on 15 April.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "Ms Hughes downloaded the app on 6 January, paid the subscription fee, completed all workouts, and weighed in on 15 April with a loss of 1.2 kg.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "On 20 April, Ms Hughes claimed the \u00a32,000 but PeakFit denied contractual obligation arguing the advertisement was only an invitation to treat and not an offer.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "PeakFit's terms allowed withdrawal of promotions at any time, but no withdrawal occurred before 15 April.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "More than 3,000 people participated, and PeakFit claims the advertisement was marketing puff, not a binding offer.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Ms Hughes aims to enforce the promise to pay \u00a32,000 as a binding contract.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Ms Hughes wants to enforce PeakFit's promise to pay \u00a32,000 as a binding contract and claim the money.",
      "citations": [
        "F7"
      ]
    }
  },
