    "key_facts": [
      {
        "text": "Ms Adeyemi arrived at the Harbourside Hotel without a booking and requested a room on 12 August 2025.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "She signed a registration card recording her name, address and car registration; the card contained no terms and conditions and no reference to any terms or exclusions.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "A notice on the back of her bedroom door stated that the hotel accepted no liability for loss of or damage to guests' property and advised depositing valuables at reception.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "The same exclusion terms appear on the hotel website, which Ms Adeyemi had never visited.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "On 13 August 2025, her laptop and a diamond bracelet worth \u00a36,500 in total were stolen from her room; police found no forced entry but a staff member had left a master key unattended.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "The hotel relies on the bedroom door notice to exclude liability and claims Ms Adeyemi should have deposited her valuables at reception.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Ms Adeyemi wishes to recover the value of her stolen property and argues that the exclusion notice was not part of her contract with the hotel.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Ms Adeyemi wants to recover the value of her stolen property and argues that the notice excluding liability is not part of her contract with the hotel.",
      "citations": [
        "F7"
      ]
    }
