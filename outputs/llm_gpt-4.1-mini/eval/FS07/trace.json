    "key_facts": [
      {
        "text": "Brennan Joinery Ltd was contracted by Castlegate Developments Ltd in January 2025 to fit kitchens and staircases in 30 townhouses for \u00a3150,000, with completion by 30 June 2025.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "Castlegate's main contract includes a liquidated damages clause of \u00a35,000 per day for late completion.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "By April 2025, Brennan had completed 12 houses but warned of financial difficulties and possible failure to complete.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "On 14 April 2025, Castlegate promised an extra \u00a31,000 per remaining house completed on time to avoid penalties or hiring another joiner.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "Brennan completed the remaining 18 houses by the deadline, but Castlegate paid only the original contract price, refusing the extra \u00a318,000.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "There is no evidence Brennan threatened to abandon the work; the promise of extra payment came solely from Castlegate.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Brennan is seeking to recover the promised extra payment of \u00a318,000.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Brennan wants to recover the promised extra payment of \u00a318,000.",
