    "key_facts": [
      {
        "text": "Mr Rowe agreed to hire the rooftop terrace for \u00a312,000 and paid a \u00a34,000 deposit on 10 May 2025",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "Skyline's online listing promoted the terrace as having the best view of the Thames Victory Fireworks, and promises were made about front-row seats to watch the fireworks",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "The written hire agreement did not mention the fireworks and only provided for exclusive use of the terrace with bar service",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "The fireworks display was cancelled by the council on 28 June 2025 after a safety review",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "Despite the fireworks cancellation, the terrace, bar, and staff remained available on the event date, 5 July 2025",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Mr Rowe cancelled the event on 29 June 2025 and requested the return of his deposit",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Skyline refuses to return the deposit and claims the remaining balance of \u00a38,000, arguing the terrace was still usable and the fireworks were only Mr Rowe's commercial purpose",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Mr Rowe argues that the hire contract was frustrated due to the cancellation of the fireworks and seeks to avoid payment for the balance and recover the deposit",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Mr Rowe argues that the hire contract was frustrated by the cancellation of the fireworks. He wants his deposit back and to avoid paying the balance.",
      "citations": [
        "F7"
      ]
    }
  },
