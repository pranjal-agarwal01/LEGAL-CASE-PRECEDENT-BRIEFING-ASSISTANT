    "key_facts": [
      {
        "text": "Mr Rowe agreed to hire Skyline's rooftop terrace for 5 July 2025 for \u00a312,000 and paid a \u00a34,000 deposit",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "Skyline's online listing advertised the terrace as offering the best view of the Thames Victory Fireworks, a planned display, and assured front-row seats for the display in correspondence",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "The written hire agreement only mentioned exclusive use of the terrace from 6pm to midnight with bar service and did not mention the fireworks",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "The fireworks display was cancelled by the council on 28 June 2025 after a safety review",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "The terrace, bar and staff were still available on the booked date but Mr Rowe cancelled the event and requested his deposit back",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Skyline refuses to return the deposit and claims the remaining balance, arguing the terrace was still usable and that the fireworks were only Mr Rowe's commercial purpose",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Mr Rowe argues that the hire contract was frustrated by the cancellation of the fireworks and seeks return of his deposit and to avoid paying the balance",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Mr Rowe argues that the hire contract was frustrated by the cancellation of the fireworks. He wants his deposit back and to avoid paying the balance.",
      "citations": [
        "F7"
      ]
    }
