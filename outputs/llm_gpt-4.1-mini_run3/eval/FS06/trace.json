    "key_facts": [
      {
        "text": "Ms Adeyemi arrived at the hotel on 12 August 2025 without a prior booking and requested a room at reception.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "She signed a registration card at reception that recorded her personal details but contained no terms or conditions and paid for two nights, receiving a key card.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "A notice on the back of Ms Adeyemi's bedroom door excluded liability for loss or damage to guests' property left in rooms and advised valuables be deposited at reception.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "The same exclusion terms appeared on the hotel's website, which Ms Adeyemi had not visited.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "On 13 August 2025, while Ms Adeyemi was at dinner, her laptop and a diamond bracelet worth \u00a36,500 were stolen from her room; the police found no forced entry, but a staff member had left a master key card unattended on a cleaning trolley.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "The hotel relies on the notice on the bedroom door to exclude liability and argues that Ms Adeyemi should have deposited her valuables at reception.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Ms Adeyemi seeks to recover the value of her stolen property on the basis that the exclusion notice is not part of her contract with the hotel.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Ms Adeyemi wants to recover the value of her stolen property and argues that the notice excluding liability is not part of her contract with the hotel.",
      "citations": [
        "F7"
      ]
    }
