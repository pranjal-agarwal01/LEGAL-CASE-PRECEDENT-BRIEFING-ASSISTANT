      {
        "claimant": "Megan Hughes",
        "respondent": "PeakFit Ltd",
        "claim": "Ms Hughes claims the \u00a32,000 payment promised by PeakFit for completing the workouts and losing 5 kg is contractually binding, and seeks enforcement of this promise.",
        "legal_basis": "Breach of contract based on offer and acceptance forming a binding contract.",
        "fact_refs": [
          "F1",
          "F3",
          "F4",
          "F7"
        ]
      }
    ],
    "key_facts": [
      {
        "text": "PeakFit published an advertisement promising \u00a32,000 to participants who completed 100 workouts and lost 5 kg by 15 April, stating \u00a3100,000 was held at Barclays as a sign of commitment.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "Participants had to log every workout and weigh themselves on the app's connected scales on 15 April.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "Ms Hughes downloaded the app on 6 January, paid \u00a39.99, logged all workouts, and on 15 April weighed in reporting a 1.2 kg weight loss.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "On 20 April, Ms Hughes claimed the \u00a32,000 prize; PeakFit denied the claim stating the advertisement was marketing puff and an invitation to treat, not a contract, and that she should have notified them when starting.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "PeakFit's terms allow withdrawal of promotions at any time but it did not withdraw this promotion before 15 April.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Over 3,000 people downloaded the app during the promotion; PeakFit claims it never intended to be legally bound and considered the advertisement as marketing puff.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Ms Hughes intends to enforce PeakFit's promise and claim the money.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Ms Hughes wants to enforce PeakFit's promise to pay \u00a32,000 as a binding contract and claim the money.",
      "citations": [
        "F7"
      ]
    }
  },
