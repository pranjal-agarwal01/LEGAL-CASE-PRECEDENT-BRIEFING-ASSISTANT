    "key_facts": [
      {
        "text": "PeakFit published a promotional advertisement promising \u00a32,000 to anyone who completes 100 daily workouts by 15 April and loses 5 kg, backing the promise with \u00a3100,000 placed in Barclays.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "The advertisement required participants to log all workouts and weigh in on connected scales on 15 April to qualify.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "Ms Hughes downloaded the app on 6 January, paid the subscription fee, logged all 100 workouts, and weighed in on 15 April, losing only 1.2 kg.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "Ms Hughes claimed the \u00a32,000 prize after the competition ended by emailing PeakFit on 20 April.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "PeakFit denied liability, stating the advertisement was marketing puff and an invitation to treat, and no acceptance occurred as Ms Hughes did not notify them at start.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "PeakFit's general terms allow promotions to be withdrawn anytime, but this promotion was not withdrawn before 15 April 2025.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Over 3,000 people downloaded the app during the promotion; PeakFit claims it did not intend to be legally bound and considered the advertisement marketing puff.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Ms Hughes seeks to enforce the \u00a32,000 payment as a binding contract claim.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Ms Hughes wants to enforce PeakFit's promise to pay \u00a32,000 as a binding contract and claim the money.",
