    "claims": [
      {
        "claimant": "Kaur Artisan Bakery Ltd",
        "respondent": "SwiftHaul Couriers Ltd",
        "claim": "Damages for breach of the delivery contract due to late delivery causing losses including lost ordinary trade profits and a lost one-off contract.",
        "legal_basis": "Breach of contract",
        "fact_refs": [
          "F4",
