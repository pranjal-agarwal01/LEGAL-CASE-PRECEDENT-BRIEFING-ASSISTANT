      }
    ],
    "key_facts": [
      {
        "text": "The bakery's industrial oven failed on 3 September 2025 and needed the controller board repaired at the manufacturer's workshop in Birmingham.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "On 4 September 2025, the bakery booked SwiftHaul's guaranteed next-day delivery service describing the parcel as 'electronic component' without informing about its inability to trade without it.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "The bakery accepted SwiftHaul's terms and conditions including clause 9 which excludes liability for any loss of profit, business, or contracts arising from delay.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "SwiftHaul mistakenly sent the parcel to the wrong depot and delivered it eleven days late on 15 September 2025.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "The bakery was unable to bake for twelve days, losing about \u00a318,000 in ordinary trade profits and a \u00a340,000 contract for a celebrity wedding, which SwiftHaul did not know about.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "SwiftHaul argues it could not have contemplated the bakery's inability to trade or the exceptional wedding contract, and relies on clause 9 to exclude liability for these losses.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "The bakery claims damages for breach of contract covering its lost profits and lost wedding contract due to the late delivery.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "The bakery wants to claim damages for breach of the delivery contract, including its lost profits and the lost wedding contract.",
      "citations": [
        "F7"
      ]
    }
  },
