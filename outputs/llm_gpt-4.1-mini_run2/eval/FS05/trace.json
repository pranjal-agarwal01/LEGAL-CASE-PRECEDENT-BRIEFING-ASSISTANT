      },
      {
        "date": "4 September 2025",
        "iso_date": "2025-09-04",
        "event": "The bakery's manager ticked a box confirming acceptance of SwiftHaul's terms and conditions, including clause 9 excluding liability for loss of profit, business or contracts arising from delay.",
