    "key_facts": [
      {
        "text": "Mr Rowe agreed to hire the terrace on 10 May 2025 for \u00a312,000 and paid a \u00a34,000 deposit",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "Skyline advertised the terrace as offering \"the best view in London of the Thames Victory Fireworks\" and promised front-row seats, while Mr Rowe stated his guests were coming to watch the fireworks",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "The written hire agreement only described exclusive use of the terrace from 6pm to midnight with bar service and did not mention the fireworks",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "On 28 June 2025, the council cancelled the fireworks display for safety reasons",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "The terrace, bar, and staff remained available on 5 July 2025 despite cancellation of the fireworks",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Mr Rowe cancelled the event on 29 June 2025 and asked for his deposit back",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Skyline refuses to return the deposit and claims the outstanding \u00a38,000 balance, arguing the terrace could still be used and the fireworks were only Mr Rowe's commercial purpose",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Mr Rowe argues that the hire contract is frustrated by the cancellation of the fireworks and seeks repayment of his deposit and to avoid paying the balance",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Mr Rowe argues that the hire contract was frustrated by the cancellation of the fireworks. He wants his deposit back and to avoid paying the balance.",
      "citations": [
        "F7"
      ]
    }
