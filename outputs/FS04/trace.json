    "key_facts": [
      {
        "text": "Mr Rowe agreed on 10 May 2025 to hire the rooftop terrace for 5 July 2025, paying \u00a312,000 with a \u00a34,000 deposit.",
        "citations": [
          "F1"
        ]
      },
      {
        "text": "Skyline advertised the terrace as offering the best view of the Thames Victory Fireworks and promised front-row seats, which influenced Mr Rowe's decision as he planned his guests to watch the fireworks.",
        "citations": [
          "F2"
        ]
      },
      {
        "text": "The hire agreement only described exclusive use of the terrace from 6pm to midnight with bar service and did not mention the fireworks display.",
        "citations": [
          "F3"
        ]
      },
      {
        "text": "The council cancelled the fireworks display on 28 June 2025 after a safety review.",
        "citations": [
          "F4"
        ]
      },
      {
        "text": "The terrace, bar, and staff remained available on 5 July 2025, but Mr Rowe cancelled his event and requested his deposit back on 29 June 2025.",
        "citations": [
          "F5"
        ]
      },
      {
        "text": "Skyline refused to return the deposit and claims the balance of \u00a38,000, arguing the terrace could still be used and the fireworks were only Mr Rowe's own commercial purpose.",
        "citations": [
          "F6"
        ]
      },
      {
        "text": "Mr Rowe asserts that the contract was frustrated by the cancellation of the fireworks, seeking a refund of his deposit and to avoid paying the remaining balance.",
        "citations": [
          "F7"
        ]
      }
    ],
    "objective": {
      "text": "Mr Rowe argues that the hire contract was frustrated by the cancellation of the fireworks. He wants his deposit back and to avoid paying the balance.",
      "citations": [
        "F7"
      ]
    }
  },
