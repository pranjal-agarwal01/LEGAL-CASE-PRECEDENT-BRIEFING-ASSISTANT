# Copy to .env and fill in the provider you want. Offline mode needs nothing.
#
# LLM_PROVIDER: offline | foundry | openai | azure_openai | anthropic | ollama
LLM_PROVIDER=offline

# --- Microsoft Foundry (LLM_PROVIDER=foundry) ---
# Endpoint and key: Foundry portal -> your resource -> Overview / Keys and Endpoint.
# LLM_MODEL must be your DEPLOYMENT name. Names starting with "claude" use the Claude client,
# anything else (gpt-4.1, gpt-4o, ...) uses the Azure OpenAI chat-completions client.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-10-21

# Model / deployment name for the chosen provider.
# openai: e.g. gpt-4.1 ; azure_openai: your deployment name ; ollama: e.g. llama3.1:8b
# anthropic: defaults to claude-opus-5-5 when left empty
LLM_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Ollama (OpenAI-compatible endpoint) ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Pipeline knobs ---
DEBATE_ROUNDS=2
RETRIEVAL_TOP_K=5
# Weight of the doctrine-metadata boost added to the hybrid (BM25 + LSA) score. 0 = text only.
DOCTRINE_BOOST=0.35

# --- Semantic search (optional) ---
# An embedding deployment in the same Foundry / Azure OpenAI resource, e.g. text-embedding-3-small.
# Empty = keyword search (BM25 + LSA) plus the retrieval agent's own reranking.
EMBEDDING_MODEL=
EMBEDDING_DIMS=512

# --- Library ---
# The CLI and evaluation use the 50 case summaries only; the web app always adds legislation.
INCLUDE_LEGISLATION=false
INCLUDE_SUMMARIES=true
# Check every cited passage against the statement it supports (LLM mode).
VERIFY_SUPPORT=true

# --- Web app ---
# Local default is SQLite in ./var/app.db. On Render this is set from the Postgres database.
DATABASE_URL=
# Required in production: a long random string used to sign session cookies.
SECRET_KEY=
ALLOW_SIGNUP=true
MAX_CONCURRENT_RUNS=2
RUNS_PER_FIRM_PER_DAY=40
MAX_UPLOAD_MB=15

# Optional stronger model (same provider) for writing the brief and checking sources, e.g. gpt-5-mini.
# Reasoning models need a larger LLM_MAX_TOKENS (e.g. 32000). Tested: gpt-4.1-mini is the better default.
COMPILER_MODEL=

# Optional model for the source check only. Tested: gpt-5-mini grades support and relevance more strictly
# than gpt-4.1-mini (used in production).
CHECKER_MODEL=
